# --- DATABASE CONFIGURATION ---
# Use the full URL from the Railway "Connect" tab
# DATABASE_URL=postgres://postgres:your_actual_password@your_actual_host_address:5432/railway

# --- CLOUDINARY CONFIGURATION ---
# Find these in your Cloudinary Dashboard under "Programmable Media"
CLOUDINARY_CLOUD_NAME=your_actual_cloud_name
CLOUDINARY_API_KEY=your_actual_api_key
CLOUDINARY_API_SECRET=your_actual_api_secret

# --- DJANGO CONFIGURATION ---
SECRET_KEY=some-random-long-string-of-characters
DEBUG=True