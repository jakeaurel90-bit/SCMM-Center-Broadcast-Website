PORT=3000

# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Login credentials for the dashboard
ADMIN_USERNAME=SCMM
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=

# --- YouTube ---
# YouTube Studio > Go Live > Stream > copy "Stream URL" and "Stream key"
YT_STREAM_URL=rtmp://a.rtmp.youtube.com/live2
YT_STREAM_KEY=

# --- Facebook ---
# Facebook Live Producer > "Use Stream Key" > copy Server URL and Stream key
FB_STREAM_URL=rtmps://live-api-s.facebook.com:443/rtmp
FB_STREAM_KEY=
